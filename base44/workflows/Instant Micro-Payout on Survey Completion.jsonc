{
  "name": "Instant Micro-Payout on Survey Completion",
  "description": "Pays respondents immediately when their survey response is marked completed.",
  "trigger": {
    "condition": "${ (.trigger.data.completed == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PPCSurveyResponse"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "instant_micro_payout_on_survey_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "respondentMicroPayout",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "respondentMicroPayout"
  }
}