{
  "name": "Notify High Quality Survey Response",
  "description": "Sends bonus notification when a survey response is flagged as high quality.",
  "trigger": {
    "condition": "${ (.trigger.data.quality_score >= 85) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PPCSurveyResponse"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_high_quality_survey_response",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyHighQualityResponse",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyHighQualityResponse"
  }
}