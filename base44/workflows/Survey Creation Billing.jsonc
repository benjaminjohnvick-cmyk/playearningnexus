{
  "name": "Survey Creation Billing",
  "description": "Automatically charges the survey creation fee when a new PPC survey is created.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PPCSurvey"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "survey_creation_billing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "chargeSurveyCreation",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "chargeSurveyCreation"
  }
}