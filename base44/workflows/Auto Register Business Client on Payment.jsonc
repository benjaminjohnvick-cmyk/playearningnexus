{
  "name": "Auto Register Business Client on Payment",
  "description": "Automatically registers a user as a BusinessClient when they complete a business-type payment (priority_payment or install_fee).",
  "trigger": {
    "condition": "${ ((.trigger.data.transaction_type == \"priority_payment\" or .trigger.data.transaction_type == \"install_fee\") and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Transaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_register_business_client_on_payment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoRegisterBusinessClient",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoRegisterBusinessClient"
  }
}