{
  "name": "Auto-Process Referral Commissions",
  "description": "Automatically processes referral commissions on every new survey earning transaction",
  "trigger": {
    "condition": "${ (.trigger.data.transaction_type == \"survey_earning\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Transaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_process_referral_commissions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processReferralCommissions",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processReferralCommissions"
  }
}