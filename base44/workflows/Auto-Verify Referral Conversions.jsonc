{
  "name": "Auto-Verify Referral Conversions",
  "description": "Automatically verifies referral conversions when a referral becomes active",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Referral"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_verify_referral_conversions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verifyReferralConversion",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "verifyReferralConversion"
  }
}