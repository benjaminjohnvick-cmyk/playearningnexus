{
  "name": "Tournament Matchmaking on Registration Close",
  "description": "Auto-generates AI skill-based brackets when a tournament status changes to active.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"active\") and (.trigger.data.bracket_generated != true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Tournament"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tournament_matchmaking_on_registration_close",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "tournamentMatchmaker",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "tournamentMatchmaker"
  }
}