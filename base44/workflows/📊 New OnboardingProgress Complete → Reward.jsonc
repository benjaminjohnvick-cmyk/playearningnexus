{
  "name": "\ud83d\udcca New OnboardingProgress Complete \u2192 Reward",
  "description": "Grants XP and welcome reward when user completes onboarding",
  "trigger": {
    "condition": "${ (.trigger.data.completed == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "OnboardingProgress"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_onboardingprogress_complete_reward",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCommunityEngine",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCommunityEngine"
  }
}