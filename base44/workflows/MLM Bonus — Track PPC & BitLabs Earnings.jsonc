{
  "name": "MLM Bonus \u2014 Track PPC & BitLabs Earnings",
  "description": "Fires whenever a PPCTransaction is created to check if a referred user crossed an $8 milestone and distribute $0.25 MLM bonuses up the 3-level chain",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PPCTransaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "mlm_bonus_track_ppc_bitlabs_earnings",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "distributeMLMBonus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "distributeMLMBonus"
  }
}