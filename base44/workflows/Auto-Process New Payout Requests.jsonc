{
  "name": "Auto-Process New Payout Requests",
  "description": "Immediately fraud-screens every new payout request on creation",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Payout"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_process_new_payout_requests",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiPayoutFraudDetection",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "aiPayoutFraudDetection"
  }
}