{
  "name": "UXSessionRecording Updated \u2192 Fraud Flagged/Escalated \u2192 Create SupportTicket + Admin Alert + Flag Response",
  "description": "When fraud_analysis_status becomes flagged/escalated: auto-creates SupportTicket, notifies admins, flags linked PPCSurveyResponse if score >= 80",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"fraud_analysis_status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "UXSessionRecording"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "uxsessionrecording_updated_fraud_flagged_escalated_create_supportticket_admin_alert_flag_response",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoUXFraudEscalation",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoUXFraudEscalation"
  }
}