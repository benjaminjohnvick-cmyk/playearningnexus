{
  "name": "MLM Bonus \u2014 Track DailyEarnings Milestones",
  "description": "Fires whenever a DailyEarnings record is created/updated to check for $8 milestones and distribute MLM bonuses",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "DailyEarnings"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "mlm_bonus_track_dailyearnings_milestones",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "distributeMLMBonus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "distributeMLMBonus"
  }
}