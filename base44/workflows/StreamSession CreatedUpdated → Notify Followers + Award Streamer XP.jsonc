{
  "name": "StreamSession Created/Updated \u2192 Notify Followers + Award Streamer XP",
  "description": "Notifies up to 30 subscribers when streamer goes live; awards XP and sends summary when stream ends",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "StreamSession"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "streamsession_created_updated_notify_followers_award_streamer_xp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoStreamSessionLifecycle",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoStreamSessionLifecycle"
  }
}