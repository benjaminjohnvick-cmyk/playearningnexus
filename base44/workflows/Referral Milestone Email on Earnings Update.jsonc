{
  "name": "Referral Milestone Email on Earnings Update",
  "description": "Fires milestone celebration email when a referral's total_earnings crosses key thresholds.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"total_earnings\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Referral"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "referral_milestone_email_on_earnings_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "referralMilestoneEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "referralMilestoneEmail"
  }
}