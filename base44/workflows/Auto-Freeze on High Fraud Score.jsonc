{
  "name": "Auto-Freeze on High Fraud Score",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.fraud_score >= 75) and (.trigger.data.fraud_analysis_status == \"flagged\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "UXSessionRecording"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_freeze_on_high_fraud_score",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "realtimeFraudMonitor",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "realtimeFraudMonitor"
  }
}