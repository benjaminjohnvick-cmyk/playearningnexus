{
  "name": "Multi-Tier Referral Commission Processor",
  "description": "Auto-calculates and credits multi-tier referral commissions (5%/2%/1%) when a referred user completes a survey",
  "trigger": {
    "condition": "${ (.trigger.data.completed == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PPCSurveyResponse"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "multi_tier_referral_commission_processor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processReferralCommissions",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processReferralCommissions"
  }
}