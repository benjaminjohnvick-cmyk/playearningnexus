{
  "name": "AI Business Client Verification",
  "description": "Automatically runs AI fraud/legitimacy verification when a new BusinessClient record is created. Sets account_status to active or suspended based on AI decision.",
  "trigger": {
    "condition": "${ (.trigger.data.account_status == \"pending\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BusinessClient"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_business_client_verification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verifyBusinessClient",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "verifyBusinessClient"
  }
}