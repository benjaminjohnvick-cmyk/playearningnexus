{
  "name": "Award Jackpot on Referral Signup",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.referrer_user_id != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Referral"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "award_jackpot_on_referral_signup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "awardReferralJackpotEntries",
            "args": {
              "trigger_type": "signup"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "awardReferralJackpotEntries"
  }
}