{
  "name": "Survey Match Notifications",
  "description": "Sends push notifications to all matching respondents when a new survey becomes available.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PPCSurvey"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "survey_match_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewSurveyMatch",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNewSurveyMatch"
  }
}