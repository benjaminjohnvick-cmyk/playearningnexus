{
  "name": "UserActivity Created \u2192 XP Rollup to UserLevel (triggers level-up chain)",
  "description": "Every activity with points_earned updates UserLevel total XP, calculates new level \u2014 triggering the level-up automation chain",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "UserActivity"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "useractivity_created_xp_rollup_to_userlevel_triggers_level_up_chain",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoUserActivityXPRollup",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoUserActivityXPRollup"
  }
}