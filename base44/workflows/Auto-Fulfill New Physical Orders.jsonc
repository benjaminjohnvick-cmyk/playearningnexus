{
  "name": "Auto-Fulfill New Physical Orders",
  "description": "Automatically triggers full AI order fulfillment (find listing, browser checkout, tracking) the moment a new physical product order is created",
  "trigger": {
    "condition": "${ ((.trigger.data.product_type == \"physical_product\") and (.trigger.data.shipping_status == \"pending_ai_fulfillment\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_fulfill_new_physical_orders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiOrderFulfillment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "aiOrderFulfillment"
  }
}