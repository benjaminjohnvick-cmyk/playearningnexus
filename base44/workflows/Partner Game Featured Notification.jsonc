{
  "name": "Partner: Game Featured Notification",
  "description": "Fires when a Game's status changes to 'featured' \u2014 notifies the developer",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"featured\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Game"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "partner_game_featured_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "partnerNotificationWebhook",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "partnerNotificationWebhook"
  }
}