    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Referral"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "referral_updated_conversion_handler_mlmnode_referralachievement_xp_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoReferralConversionHandler",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoReferralConversionHandler"
  }
}