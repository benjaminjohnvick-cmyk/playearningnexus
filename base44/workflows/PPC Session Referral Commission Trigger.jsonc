{
  "name": "PPC Session Referral Commission Trigger",
  "description": "Fires when a new PPC session is recorded to calculate and pay referral commissions",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PPCSession"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ppc_session_referral_commission_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processPPCSession",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processPPCSession"
  }
}