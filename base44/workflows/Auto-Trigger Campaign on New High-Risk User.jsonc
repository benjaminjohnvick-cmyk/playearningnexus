{
  "name": "Auto-Trigger Campaign on New High-Risk User",
  "description": "Automatically fires the retention campaign engine the moment a new critical or high-risk user is flagged \u2014 zero manual intervention needed",
  "trigger": {
    "condition": "${ ((.trigger.data.risk_level == \"high\" or .trigger.data.risk_level == \"critical\") and (.trigger.data.status == \"active\") and (.trigger.data.notification_sent == false)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "RetentionRisk"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_trigger_campaign_on_new_high_risk_user",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "retentionCampaignEngine",
            "args": {
              "dry_run": false,
              "risk_levels": [
                "high",
                "critical"
              ],
              "max_users": 1
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "retentionCampaignEngine"
  }
}