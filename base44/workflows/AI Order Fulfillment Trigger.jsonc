{
  "name": "AI Order Fulfillment Trigger",
  "description": "Automatically triggers AI fulfillment when a new order is created with pending_ai_fulfillment status",
  "trigger": {
    "condition": "${ (.trigger.data.shipping_status == \"pending_ai_fulfillment\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_order_fulfillment_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiOrderFulfillment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "aiOrderFulfillment"
  }
}