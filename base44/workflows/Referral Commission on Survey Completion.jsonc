{
  "name": "Referral Commission on Survey Completion",
  "description": "Instantly calculates and pays tier 1/2/3 referral commissions when a survey response is completed.",
  "trigger": {
    "condition": "${ (.trigger.data.completed == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PPCSurveyResponse"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "referral_commission_on_survey_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processReferralCommissions",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processReferralCommissions"
  }
}