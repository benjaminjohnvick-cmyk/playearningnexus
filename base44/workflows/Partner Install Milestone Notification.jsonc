{
  "name": "Partner: Install Milestone Notification",
  "description": "Fires when a Game's total_installs field changes \u2014 checks if a milestone was crossed",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"total_installs\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Game"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "partner_install_milestone_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "partnerNotificationWebhook",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "partnerNotificationWebhook"
  }
}