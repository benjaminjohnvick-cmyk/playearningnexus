#env
.env
.env.*
# ...but DO keep the committed env templates (they document every variable, no secrets):
!.env.example
!**/.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Native platform folders are GENERATED build artifacts, not source.
# The repo is wrapper-only: android/ and ios/ are regenerated at build time
# via `npm run native:regenerate` (npx cap add + sync) and are never committed.
/android
/ios
.gradle
*.keystore
.capacitor

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
base44/.app.jsonc

# Large generated snapshots / backups — DO NOT commit these to git.
# The git history itself is the backup (every source + doc file is versioned).
# Committing the multi-MB code snapshot and repo-backup zip bloats the repo and
# makes GitHub Desktop slow / prone to crashing. Keep them on disk, out of git.
snapshots/
*-repo-backup-*.zip
GamerGain-FULL-CODEBASE-*.txt

# sandbox walkthrough artifacts (screenshots + report)
deploy-kit/e2e/artifacts/

# CI signing secrets produced by deploy-kit/mobile/setup-signing.sh (never commit)
deploy-kit/mobile/ci-secrets*
