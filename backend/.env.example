# ---- Core ----
PORT=8000
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
PG_POOL_SIZE=10
CORS_ORIGIN=*
LOGIN_URL=/login

# ---- Auth ----
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# ---- Affirm BNPL (real shippable goods only — never points/credit) ----
# Off until keys are set AND the affirm_bnpl flag is on. Affirm underwrites each buyer and owns default
# risk; you are paid upfront. See AFFIRM-BNPL-SETUP.md.
# FLAG_AFFIRM_BNPL=1
# AFFIRM_PUBLIC_API_KEY=
# AFFIRM_PRIVATE_API_KEY=
# AFFIRM_ENV=sandbox                 # sandbox | live
# AFFIRM_API_BASE=                   # optional override; else derived from AFFIRM_ENV
# PUBLIC_SITE_URL=https://yourdomain.com   # used for Affirm confirmation/cancel redirects

# ---- LLM (you now own these rate limits) ----
# CLAUDE SWITCH: flip LLM_PROVIDER to `anthropic` and set ANTHROPIC_API_KEY to route ALL
# text/reasoning AI (InvokeLLM + all 76 agents) through Claude. No other change needed —
# the per-agent OpenAI model pins translate to their Claude equivalents automatically.
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI tiers (used when LLM_PROVIDER=openai)
LLM_MODEL_SMALL=gpt-4o-mini
LLM_MODEL_LARGE=gpt-4o
LLM_MODEL_DEFAULT=gpt-4o-mini
# Claude tiers (used when LLM_PROVIDER=anthropic). Optional — sensible defaults below.
CLAUDE_MODEL_SMALL=claude-3-5-haiku-latest
CLAUDE_MODEL_LARGE=claude-3-5-sonnet-latest
CLAUDE_MODEL_DEFAULT=claude-3-5-sonnet-latest
# ANTHROPIC_MODEL=            # optional flat override: force ONE Claude model for every tier

# ---- Email ----
EMAIL_PROVIDER=sendgrid        # sendgrid | ses
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com

# ---- Images (Claude has no image API — this is the companion provider) ----
IMAGE_PROVIDER=openai          # openai | stability | aws_bedrock | aws_sagemaker
IMAGE_MODEL=dall-e-3           # openai: dall-e-3 | stability: stable-image/generate/core
                               # aws_bedrock: amazon.nova-canvas-v1:0 | amazon.titan-image-generator-v1 | stability.stable-diffusion-xl-v1
# IMAGE_API_KEY=              # optional: separate key for image billing (else uses OPENAI_API_KEY / STABILITY_API_KEY)
# STABILITY_API_KEY=
#
# ---- Serverless GPU image generation on AWS (cheap, no per-image API list price) ----
# Two AWS paths generate ORIGINAL product images for the marketplace catalog at scale:
#   IMAGE_PROVIDER=aws_bedrock    → true serverless, no infra to run. Pay only per generated image
#                                   (fractions of a cent). Needs AWS_ACCESS_KEY_ID/SECRET + Bedrock
#                                   model access enabled in your AWS console. Set IMAGE_MODEL above.
#   IMAGE_PROVIDER=aws_sagemaker  → your OWN SDXL/FLUX model on a SageMaker endpoint. Configure the
#                                   endpoint to scale to zero (async/serverless) so you pay only while
#                                   generating. Needs AWS creds + SAGEMAKER_IMAGE_ENDPOINT.
# SAGEMAKER_IMAGE_ENDPOINT=       # name of your deployed SageMaker text-to-image endpoint
# ---- BUDGET POSTURE (≈ $10–15 one-time for ALL images, covers all countries) ----
# Defaults are already set to this posture; add AWS creds to activate. Titan Image ≈ $0.01/image.
IMAGE_PROVIDER=aws_bedrock
IMAGE_MODEL=amazon.titan-image-generator-v1
CATALOG_IMAGES_ENABLED=1          # 0 = launch text-only at $0
CATALOG_IMAGES_MAX_PER_RUN=100    # paces spend across scheduled runs
CATALOG_SUBCATEGORY_IMAGES=0      # 0 = only ~40 top-level tiles (cheap); 1 = ~905 subcategory tiles
# CATALOG_IMAGE_SIZE=1024x1024
# Catalog population (per country):
# CATALOG_COUNTRIES=US            # comma-separated ISO codes; add one when you launch a new country
# CATALOG_LISTINGS_PER_COUNTRY=24 # target active platform listings per country (seeder tops up)
# ---- Amazon Associates (OPTIONAL, authorized affiliate feed — never scraping) ----
# Only set these if you are an approved Amazon Associate. Enables affiliate listings + "find the real
# thing" affiliate search links. Without them, affiliate features stay off and search falls back to a
# neutral shopping search.
# AMAZON_ASSOCIATE_TAG=
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=

# ---- Premium PPC in-store-credit advance engine ----
# Card charges are OFF by default (test mode): the whole flow runs and ledgers update, but no
# real card is ever charged. Set to 1 ONLY after your payment processor confirms it allows this.
PREMIUM_PPC_LIVE_CHARGES=0
PPC_GRID_ANNUAL_PRICE=5000        # advertiser's annual PPC grid price
PREMIUM_ADVANCE_AMOUNT=1460       # FIXED upfront advance to the user (platform keeps $5,000-$1,460=$3,540)
PREMIUM_DAILY_MIN_EARN=8          # a "missed day" is any day the user earns less than this
PREMIUM_MISSED_DAY_CHARGE=8       # charged to the user's card per missed day
PREMIUM_BUSINESS_REFUND_PER_DAY=0 # advertiser cash-refund credit per ACTIVE day. 0 keeps the full $1,460
                                  # user offer AND ~$3,540 margin per $5,000 advertiser (advertiser still
                                  # gets the matched user + $32/day social + doubling). Raise to share more back.
PREMIUM_SOCIAL_CREDIT_PER_DAY=32  # free social-media ad credit to the business per missed day
PREMIUM_DOUBLING_MULTIPLE=2       # ads/social run until business receives 2× grid ($10,000) in orders

# ---- Compliance foundation (Master Plan 0.1–0.5) ----
# Feature kill-switches. Admins can also flip these live via the complianceFlags endpoint (DB
# override wins over env). Anything sensitive defaults to the SAFER state in code if unset.
#   FLAG_CARD_CHARGING=0            # off until processor + legal sign-off
#   FLAG_MULTI_LEVEL_REFERRALS=0   # off — single-tier referrals only (pyramid risk)
# Referral compensation model: affiliate (default, single-tier, performance-based) or mlm.
# MLM multi-level payouts require BOTH REFERRAL_MODEL=mlm AND FLAG_MULTI_LEVEL_REFERRALS=1.
REFERRAL_MODEL=affiliate
# Affiliate compensation: a ONE-TIME flat bounty per active referral, scaled by the affiliate's own
# performance tier. A referral is "active" once the referred user has earned this much:
AFFILIATE_ACTIVATION_THRESHOLD=8
# Tier thresholds (min active referrals) and the bounty paid per active referral at that tier:
AFFILIATE_TIER_BRONZE_MIN=0
AFFILIATE_BOUNTY_BRONZE=5
AFFILIATE_TIER_SILVER_MIN=10
AFFILIATE_BOUNTY_SILVER=6
AFFILIATE_TIER_GOLD_MIN=25
AFFILIATE_BOUNTY_GOLD=8
AFFILIATE_TIER_PLATINUM_MIN=50
AFFILIATE_BOUNTY_PLATINUM=10
# Commission mode: ongoing (default — a recurring % of each referral's activity, single-tier) or
# bounty (the one-time flat payout above). Ongoing rates are scaled by the affiliate's tier:
AFFILIATE_COMMISSION_MODE=ongoing
AFFILIATE_ONGOING_RATE_BRONZE=0.05
AFFILIATE_ONGOING_RATE_SILVER=0.06
AFFILIATE_ONGOING_RATE_GOLD=0.08
AFFILIATE_ONGOING_RATE_PLATINUM=0.10
#   FLAG_STORE_CREDIT_PURCHASE=0   # off — points must be EARNED, not purchased (money-transmission risk)
#   FLAG_P2P_TRANSFERS=0           # off — no user-to-user value movement (money-transmission risk)
#   FLAG_CASH_OUT=0                # off for closed-loop points
#   FLAG_SMS_MARKETING=0           # off until verifiable opt-in (TCPA)
#   FLAG_EARNINGS_PROJECTIONS=0    # off — no guaranteed-earnings UI (FTC)
# Terms version — bump this string when the ToS/Privacy Policy change to force re-consent (0.5).
TERMS_VERSION=2026-07-01
# FTC ad disclosure tag appended to sponsored social posts, and the CAN-SPAM physical address in
# the email unsubscribe footer.
AD_DISCLOSURE_TAG=#ad
BUSINESS_MAILING_ADDRESS=
# Where DMCA takedown / counter-notices are emailed (your registered designated agent).
DMCA_AGENT_EMAIL=
# Tax/1099: annual reportable-payout threshold that triggers a 1099 + backup-withholding rate.
TAX_1099_THRESHOLD=600
TAX_BACKUP_WITHHOLDING_RATE=0.24

# ---- Premium membership + points valuation ----
# Membership is for EVERY user, auto-activates after 1 day, $1/day taken from that day's EARNINGS
# ONLY (never a card, never a debt; $0 earned = $0 fee). Cancel/opt-out always honored.
MEMBERSHIP_DAILY_FEE=1
MEMBERSHIP_AUTO_UPGRADE_AFTER_DAYS=1
# Points are worth 1 cent each (like Swagbucks) but are NON-CASHABLE — catalog-only (closed-loop).
# Keeping this OFF is what preserves the money-transmitter protection.
POINT_VALUE_CENTS=1
POINTS_CASHABLE=0

# ---- Premium PPC (NO-PENALTY POINTS model) ----
# A missed day costs the user NOTHING (no charge, no debt, no points owed). These tune the
# earn-as-you-go ceiling; the old missed-day-charge vars below are LEGACY/ignored.
PREMIUM_ANNUAL_POINTS_CEILING=1460   # most a user can EARN in points per year (not a fee/debt)
PREMIUM_DAILY_EARN_CAP=4             # base per-active-day boost cap (after the front-loaded period)
# Engagement boosts (preserve the old "upfront + stay active" intent, legally):
PREMIUM_WELCOME_BONUS=25             # one-time reward at enrollment (earned, not an advance)
PREMIUM_BOOST_CAP_WEEK1=20           # front-loaded: per-day boost cap for days 1–7 ("upfront" feel)
PREMIUM_BOOST_CAP_MONTH1=8           # per-day boost cap for days 8–30
PREMIUM_STREAK_BONUS_PER_WEEK=0.1    # +10% boost per full week of consecutive active days
PREMIUM_STREAK_BONUS_CAP=0.5         # streak bonus caps at +50%
PREMIUM_LAPSE_AFTER_DAYS=14          # premium status lapses to free after this many inactive days (no debt)

# ---- Scale-ready toggles (DORMANT by default — no cost until you set them) ----
# Turn these on only when traffic justifies it; the code already supports them, so
# scaling is a config flip, not a rewrite. Leaving them blank = today's single-instance
# behaviour, unchanged.
# REDIS_URL=                  # set → hot reads (prize pool/leaderboard) served from shared Redis
# DATABASE_REPLICA_URL=       # set → read queries routed to a Postgres read replica (writes stay on primary)
# PG_REPLICA_POOL_SIZE=10
# QUEUE_DRIVER=inprocess      # set to `sqs` (+ SQS_QUEUE_URL) → slow/external jobs fan out to a worker fleet
# SQS_QUEUE_URL=

# ---- Your existing app secrets (Stripe/PayPal/Twilio/etc.) still go here ----
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
BITLABS_API_KEY=
# BitLabs postback security: set this to require a valid HMAC-SHA256 signature on survey postbacks
# (in addition to, or instead of, the &token= shared secret). The postback is REJECTED without one.
BITLABS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
APP_URL=

# ---- Phase 3: AWS (S3 uploads + SES email) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE=
S3_PRESIGN_EXPIRES=900

# ---- Phase 3: Agents ----
AGENT_MODEL=gpt-4o
AGENT_MAX_STEPS=6

# ---- Phase 3: Scheduler ----
BACKEND_URL=http://localhost:8000
SCHEDULER_SERVICE_USER_ID=00000000-0000-0000-0000-000000000001

# ---- Phase 3: Throughput (rate-limit absorption) ----
LLM_CONCURRENCY=4
EMAIL_CONCURRENCY=8

# ---- Auth: password reset + Google sign-in ----
FRONTEND_URL=http://localhost:5173             # used to build password-reset links
RESET_TOKEN_TTL_MIN=60
GOOGLE_CLIENT_ID=                              # OAuth client id for verifying Google sign-in

# ---- Email via SMTP (local Mailhog or a relay) ----
# EMAIL_PROVIDER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
# DEV ONLY: return the password-reset link in the API response (never enable in prod)
DEV_RETURN_RESET_LINK=false
